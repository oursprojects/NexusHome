<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/bg_gradient_end"
                android:startColor="@color/bg_gradient_start"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:left="-60dp"
        android:top="-120dp">
        <shape android:shape="oval">
            <size
                android:width="320dp"
                android:height="320dp" />
            <gradient
                android:endColor="@android:color/transparent"
                android:gradientRadius="180dp"
                android:startColor="@color/surface_soft_blue"
                android:type="radial" />
        </shape>
    </item>

    <item
        android:right="-80dp"
        android:bottom="-80dp">
        <shape android:shape="oval">
            <size
                android:width="220dp"
                android:height="220dp" />
            <gradient
                android:endColor="@android:color/transparent"
                android:gradientRadius="120dp"
                android:startColor="@color/bg_glow_gold"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
