<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:id="@+id/mainRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_light_gradient" tools:context=".MainActivity">

    <LinearLayout android:id="@+id/dashboardContent" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="18dp" android:paddingEnd="22dp" android:paddingBottom="8dp" app:layout_constraintBottom_toTopOf="@+id/footerContainer" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">

                <ImageView android:id="@+id/ivLogo" android:layout_width="42dp" android:layout_height="42dp" android:contentDescription="@string/desc_logo" android:src="@drawable/nexuslogo" />

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

                        <TextView android:id="@+id/tvBrandNexus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/title_nexus" android:textColor="@color/nexus_blue" android:textAppearance="@style/TextAppearance.NexusHome.DisplayLarge" />

                        <TextView android:id="@+id/tvBrandHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/title_home" android:textColor="@color/header_home_text" android:textAppearance="@style/TextAppearance.NexusHome.DisplayLarge" />
                    </LinearLayout>

                    <TextView android:id="@+id/tvBrandTagline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/label_brand_tagline" android:textColor="@color/text_body" android:textAppearance="@style/TextAppearance.NexusHome.Caption" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/headerActions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton android:id="@+id/btnHistory" style="@style/Widget.Material3.Button" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/desc_history" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" app:backgroundTint="@color/surface_action_bg" app:cornerRadius="12dp" app:icon="@drawable/ic_lucide_clock" app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="18dp" app:iconTint="@color/icon_button_tint" app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnHelp" style="@style/Widget.Material3.Button" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:contentDescription="@string/desc_help" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" app:backgroundTint="@color/surface_action_bg" app:cornerRadius="12dp" app:icon="@drawable/ic_lucide_help" app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="18dp" app:iconTint="@color/icon_button_tint" app:strokeWidth="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONNECTION STATUS CARD -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/statusContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@android:color/transparent" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:strokeWidth="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_hero_panel" android:orientation="vertical" android:padding="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

                    <TextView android:id="@+id/tvConnectionLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/label_connection" android:textAllCaps="true" android:textColor="@color/text_label" android:textAppearance="@style/TextAppearance.NexusHome.Label" />

                    <TextView android:id="@+id/tvConnectionStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status_neutral" android:paddingStart="8dp" android:paddingTop="3dp" android:paddingEnd="8dp" android:paddingBottom="3dp" android:text="@string/status_disconnected" android:textColor="@color/status_disconnected_text" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>

                <TextView android:id="@+id/tvConnectionHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/connection_hint_disconnected" android:textColor="@color/text_body" android:textAppearance="@style/TextAppearance.NexusHome.Caption" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnConnect" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" tools:ignore="TouchTargetSizeCheck,VisualLintButtonSize" android:background="@drawable/bg_primary_button_box" android:text="@string/btn_connect" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:insetTop="0dp" android:insetBottom="0dp" app:icon="@drawable/ic_lucide_bluetooth_off" app:iconGravity="textStart" app:iconPadding="6dp" app:iconSize="14dp" app:iconTint="@color/white" app:strokeWidth="0dp" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnDisconnect" style="@style/Widget.Material3.Button" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_outline_button_box" android:text="@string/btn_disconnect" android:textColor="@color/text_heading" android:textSize="11sp" android:textStyle="bold" android:insetTop="0dp" android:insetBottom="0dp" android:visibility="gone" app:strokeWidth="0dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ROOM TEMPERATURE CARD -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardTemp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@android:color/transparent" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeWidth="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_premium_card" android:gravity="center_horizontal" android:orientation="vertical" android:padding="12dp">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" tools:ignore="UseCompoundDrawables">

                    <ImageView android:id="@+id/ivTempIcon" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/temp_cold" app:tint="@color/nexus_blue" />

                    <TextView android:id="@+id/tvTempLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/label_temperature_header" android:textAllCaps="true" android:textColor="@color/text_label" android:textAppearance="@style/TextAppearance.NexusHome.Label" />
                </LinearLayout>

                <TextView android:id="@+id/tvTemperature" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:autoSizeMinTextSize="16sp" android:autoSizeStepGranularity="1sp" android:autoSizeTextType="uniform" android:gravity="center" android:includeFontPadding="false" android:lines="1" android:text="@string/temp_default" android:textColor="@color/nexus_blue" android:textAppearance="@style/TextAppearance.NexusHome.DisplayMedium" />

                <TextView android:id="@+id/tvTemperatureSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/last_sync_waiting" android:textColor="@color/text_body" android:textAppearance="@style/TextAppearance.NexusHome.Caption" tools:text="Comfortable range" />

                <TextView android:id="@+id/tvLastUpdated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/last_sync_waiting" android:textColor="@color/text_label" android:textAppearance="@style/TextAppearance.NexusHome.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/permissionCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:visibility="gone" app:cardBackgroundColor="@android:color/transparent" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeWidth="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_premium_card" android:orientation="vertical" android:padding="14dp">

                <TextView android:id="@+id/permissionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/permission_card_title" android:textColor="@color/text_heading" android:textAppearance="@style/TextAppearance.NexusHome.Title" />

                <TextView android:id="@+id/permissionBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/permission_card_body" android:textColor="@color/text_body" android:textAppearance="@style/TextAppearance.NexusHome.Body" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnGrantPermissions" style="@style/Widget.Material3.Button" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/bg_outline_button_box" android:text="@string/label_grant_permissions_banner" android:textColor="@color/text_heading" android:textSize="12sp" android:textStyle="bold" app:strokeWidth="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/tvControlsHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/label_controls" android:textAllCaps="true" android:textColor="@color/text_label" android:textAppearance="@style/TextAppearance.NexusHome.Label" />

        <LinearLayout android:id="@+id/controlFlow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">

            <!-- ROW 1: FAN & LIGHT -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">

                <!-- FAN CONTROL CARD -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardFan" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" app:cardBackgroundColor="@android:color/transparent" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeWidth="0dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_premium_card" android:orientation="vertical" android:padding="12dp">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

                            <ImageView android:id="@+id/ivFanIcon" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@null" android:src="@drawable/fan_off" />

                            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchFan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/desc_fan_switch" android:enabled="false" />
                        </LinearLayout>

                        <TextView android:id="@+id/labelFan" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/label_fan" android:textColor="@color/text_heading" android:textAppearance="@style/TextAppearance.NexusHome.Title" />

                        <TextView android:id="@+id/tvFanState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/fan_state_off" android:textColor="@color/nexus_blue" android:textStyle="bold" android:textAppearance="@style/TextAppearance.NexusHome.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space android:layout_width="10dp" android:layout_height="1dp" />

                <!-- LIGHT CONTROL CARD -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardLight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" app:cardBackgroundColor="@android:color/transparent" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeWidth="0dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_premium_card" android:orientation="vertical" android:padding="12dp">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

                            <ImageView android:id="@+id/ivLightIcon" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@null" android:src="@drawable/light_off" />

                            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/desc_light_switch" android:enabled="false" />
                        </LinearLayout>

                        <TextView android:id="@+id/labelLight" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/label_light" android:textColor="@color/text_heading" android:textAppearance="@style/TextAppearance.NexusHome.Title" />

                        <TextView android:id="@+id/tvLightState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/light_state_off" android:textColor="@color/nexus_blue" android:textStyle="bold" android:textAppearance="@style/TextAppearance.NexusHome.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <Space android:layout_width="1dp" android:layout_height="10dp" />

            <!-- ROW 2: CURTAIN & AUTOMATION -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">

                <!-- CURTAIN CONTROL CARD -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardCurtain" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" app:cardBackgroundColor="@android:color/transparent" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeWidth="0dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_premium_card" android:orientation="vertical" android:padding="12dp">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

                            <ImageView android:id="@+id/ivCurtainIcon" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@null" android:src="@drawable/curtain_closed" />

                            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchCurtain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/desc_curtain_switch" android:enabled="false" />
                        </LinearLayout>

                        <TextView android:id="@+id/labelCurtain" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/label_curtain" android:textColor="@color/text_heading" android:textAppearance="@style/TextAppearance.NexusHome.Title" />

                        <TextView android:id="@+id/tvCurtainState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/curtain_state_closed" android:textColor="@color/nexus_blue" android:textStyle="bold" android:textAppearance="@style/TextAppearance.NexusHome.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space android:layout_width="10dp" android:layout_height="1dp" />

                <!-- AUTOMATION MODE CARD -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardMode" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@android:color/transparent" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeWidth="0dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_premium_card" android:orientation="vertical" android:padding="12dp">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

                            <ImageView android:id="@+id/ivModeIcon" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@null" android:src="@drawable/mode_manual" tools:ignore="ImageContrastCheck" />

                            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/desc_mode_switch" android:enabled="false" />
                        </LinearLayout>

                        <TextView android:id="@+id/tvModeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/mode_manual_title" android:textColor="@color/text_heading" android:textAppearance="@style/TextAppearance.NexusHome.Title" />

                        <TextView android:id="@+id/tvModeState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/mode_state_manual" android:textColor="@color/nexus_blue" android:textStyle="bold" android:textAppearance="@style/TextAppearance.NexusHome.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- FOOTER -->
    <LinearLayout android:id="@+id/footerContainer" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent">

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/nexus_grey_light" />

        <TextView android:id="@+id/tvFooterCredit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="12dp" android:text="@string/footer_credit" android:textColor="@color/text_label" android:textAppearance="@style/TextAppearance.NexusHome.Caption" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

