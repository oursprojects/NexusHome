    <string name="guide_title">Quick Start Guide</string>
    <string name="guide_subtitle">A short walkthrough for pairing, monitoring, and comfortable everyday control.</string>
    <string name="btn_guide_close">Close</string>
    <string name="guide_section_connection_title">Device Connectivity</string>
    <string name="guide_section_connection_body">Pair the NexusHome hardware in system Bluetooth settings once, then use Connect inside the app whenever you are ready.</string>
    <string name="guide_section_controls_title">Hardware Controls</string>
    <string name="guide_section_controls_body">Use the dashboard toggles to manage the fan, light, and automatic behavior from one screen.</string>
    <string name="guide_section_sync_title">Data Synchronization</string>
    <string name="guide_section_sync_body">The dashboard refreshes from the hardware so your cards stay aligned with the latest device state.</string>
    <string name="guide_section_monitoring_title">Environmental Monitoring</string>
    <string name="guide_section_monitoring_body">Ambient temperature appears at the top of the dashboard with visual cues for cool, comfortable, warm, and hot ranges.</string>
    <string name="guide_section_history_title">Command Logging</string>
    <string name="guide_section_history_body">Open the history page anytime to review the commands that were successfully sent from this device.</string>
    <string name="btn_close">Close</string>
